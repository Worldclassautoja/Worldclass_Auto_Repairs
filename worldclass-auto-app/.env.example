# Copy this file to .env.local and fill in your values

# Neon Postgres — get from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session signing secret — any random string
ADMIN_JWT_SECRET=your-secret-here

# Resend email — get from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address (use onboarding@resend.dev until you verify a domain)
EMAIL_FROM=WorldClass Auto <onboarding@resend.dev>

# Your deployed URL (update after deploying)
NEXT_PUBLIC_URL=http://localhost:3000
